# Reference only. You do not create a .env file. See SETUP.md for where each value goes.

# --- GitHub, Settings, Secrets and variables, Actions, "Variables" tab ---
VITE_SUPABASE_URL=https://YOUR-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_URL=https://YOUR-REF.supabase.co/functions/v1
SUPABASE_PROJECT_REF=YOUR-REF

# --- GitHub, "Secrets" tab ---
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# --- Supabase, Edge Functions, Secrets (SUPABASE_URL and the service key are added by Supabase itself) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PLATFORM_FEE_PERCENT=15
ALLOWED_ORIGIN=https://YOURNAME.github.io
SITE_URL=https://YOURNAME.github.io/YOUR-REPO
PAYSTACK_CALLBACK_URL=https://YOURNAME.github.io/YOUR-REPO/
IP_HASH_SALT=long-random-text
GUEST_TOKEN_SECRET=another-long-random-text
ENABLED_CURRENCIES=NGN
MAX_FILE_BYTES=52428800
# Optional, for emails (see docs/email-setup.md)
RESEND_API_KEY=
EMAIL_FROM=
